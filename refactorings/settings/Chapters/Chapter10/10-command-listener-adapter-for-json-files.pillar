		            newTempFilePrefix:
		            'EDASStompTopicListenerSettingsJsonAdapterTest'
		            suffix: '.json'.
	commandListener := Dictionary new.
	commandListener at: 'port' put: 61613.
	dict := Dictionary new.
	dict at: 'commandListener' put: commandListener.
	json := String streamContents: [ :stream |
		        (NeoJSONWriter on: stream)
			        asciiOnly: true;
			        nextPut: dict ].
	tempFile writeStreamDo: [ :s | s nextPutAll: json ].
	self
		assert:
			(EDASStompTopicListenerSettingsJsonAdapter fromFile: tempFile withApp: nil) port
			= 61613
		description: 'Port parsing failed'
		resumable: true.
	tempFile delete
]]]

The test fails because we're not reading the port setting from the json.

% ${changes:path=code/036-EDASStompTopicListenerSettingsJsonAdapter_class_fromFile_withApp_.ombu}
[[[methodDefinition=true
EDASStompTopicListenerSettingsJsonAdapter class >> fromFile: aFileReference withApp: anEDAApplication

	| result json commandListener |
	result := self withApp: anEDAApplication.
	json := (NeoJSONReader on: aFileReference readStream) next.
	commandListener := json at: 'commandListener'.
	result host: (commandListener at: 'host').
	result port: (commandListener at: 'port').
	^ result
]]]

The new test passes, but the previous ones now fail because we are trying to read the port information, and we're not including it in the temporary files within the host tests.

Since this will happen for all settings, let's use a method to build a dictionary with the default values to include in the JSON file used in the tests.

% ${changes:path=code/037-EDASStompTopicListenerSettingsJsonAdapterTest_defaultCommandListener_.ombu}
[[[methodDefinition=true
{ category: 'helpers' }
EDASStompTopicListenerSettingsJsonAdapterTest >> defaultCommandListener

	| result |
	result := Dictionary new.
	result
		at: 'host' put: 'localhost';
		at: 'port' put: 61613;
		at: 'user' put: 'user1';
		at: 'password' put: 'secret';
		at: 'queue' put: 'pharoeda';
		at: 'durable' put: true;
		at: 'ack' put: 'client-individual';
		at: 'prefetchCount' put: 1;
		at: 'timeout' put: 60;
		at: 'debug' put: true;
		at: 'restartOnErrors' put: true;
		at: 'errorStrategyName' put: 'EDAEJustLogErrorStrategy'.
	^ result
]]]

